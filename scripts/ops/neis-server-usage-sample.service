[Unit]
Description=NEIS Circle secure OVH server metrics snapshot
After=docker.service neis-private-monitor.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/neis-supabase
ExecStart=/usr/bin/python3 -B /home/ubuntu/.local/share/neis-private-monitor/ingest.py
TimeoutStartSec=45
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal
