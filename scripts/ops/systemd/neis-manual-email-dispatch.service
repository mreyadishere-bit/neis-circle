[Unit]
Description=NEIS Circle manual content emails (OVH only)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/neis-supabase
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/ubuntu/.local/share/neis-private-monitor/manual-email-dispatch.py
TimeoutStartSec=120
